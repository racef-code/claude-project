GOOGLE_API_KEY=your_google_api_key_here

# Dropbox integration (optional — leave blank to disable)
# Preferred: refresh token never expires. Get these from https://www.dropbox.com/developers/apps
# then run: python get_dropbox_token.py
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret
DROPBOX_REFRESH_TOKEN=your_refresh_token
DROPBOX_FOLDER=/images
# Legacy fallback (expires after a few hours — avoid using in production):
# DROPBOX_TOKEN=your_dropbox_access_token_here

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secret_key_here

# Set to true only for local development
FLASK_DEBUG=true

# Users (up to 3 hardcoded accounts)
USER1_USERNAME=john
USER1_PASSWORD=pass123
USER2_USERNAME=sarah
USER2_PASSWORD=pass456
USER3_USERNAME=me
USER3_PASSWORD=pass789
